[Unit]
Description=Select the daily Pentra X reply target subset
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/pentra-x
ExecStart=/usr/sbin/runuser -u ubuntu -- /opt/pentra-x/venv/bin/python /opt/pentra-x/scripts/select_x_reply_targets.py --pool /opt/pentra-x/research/output/pentra-x-reply-targets.json --config /opt/pentra-x/config.json --state-db /opt/pentra-x/state.db --report /opt/pentra-x/research/output/active-x-reply-targets.json
ExecStartPost=/usr/bin/python3 /opt/pentra-x/scripts/restart_reply_if_targets_changed.py --report /opt/pentra-x/research/output/active-x-reply-targets.json
StandardOutput=append:/opt/pentra-x/target-selector.log
StandardError=append:/opt/pentra-x/target-selector.log
