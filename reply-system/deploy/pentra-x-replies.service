[Unit]
Description=Pentra X reply detection and Telegram approvals
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/pentra-x
ExecStart=/opt/pentra-x/venv/bin/python -m bot.replies_daemon
Restart=on-failure
RestartSec=30
StandardOutput=append:/opt/pentra-x/replies.log
StandardError=append:/opt/pentra-x/replies.log

[Install]
WantedBy=multi-user.target
