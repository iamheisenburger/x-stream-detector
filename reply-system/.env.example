# Pentra X reply system. Copy to .env on the server only; never commit .env.
# Anthropic key used for reply drafts (and original posts, if authorized).
X_ANTHROPIC_API_KEY=
# Pentra's own X developer app (separate project from any other brand's app:
# X allows one filtered-stream connection per project).
X_API_KEY=
X_API_SECRET=
# Optional; derived from X_API_KEY/X_API_SECRET when empty.
X_BEARER_TOKEN=
# User tokens for @pentradev. Needed only for official original posts.
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Telegram bot from @BotFather and the chat (private or group) that gets drafts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: where the "Open reply in X app" button points.
# Default https://pentra.dev/x-reply; https://x.com/intent/post also works.
PENTRA_X_REPLY_HANDOFF_ROOT=
