# Copy to .env and fill in. Never commit .env.
# From your X developer app (console.x.com). Either the bearer token, or the key and secret.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
# Optional: Telegram alerts (output.telegram = true).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: signs webhook bodies (header X-Signature-256).
WEBHOOK_SECRET=
